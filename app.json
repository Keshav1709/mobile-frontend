{
  "expo": {
    "name": "Zero Forg",
    "slug": "zeroforg-mobile",
    "owner": "mobile-app-zero-forg-team",
    "scheme": "zeroforg",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeroforg.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing code shown by your Zero Forg Agent.",
        "NSLocalNetworkUsageDescription": "Find and connect cameras on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "backgroundColor": "#0C0D0D",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.zeroforg.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "backgroundColor": "#0C0D0D",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing code shown by your Zero Forg Agent.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0C0D0D",
          "dark": {
            "backgroundColor": "#0C0D0D"
          }
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "backgroundColor": "#0C0D0D",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "881bba61-b8c3-4b99-a845-f39fe8a1380c"
      }
    }
  }
}
