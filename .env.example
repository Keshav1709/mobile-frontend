# Firebase web config. Leave blank to run in development mode:
# sign-in mints an unverified local token that the cloud registry accepts
# while CLOUD_ENV is not "production".
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client IDs for Google sign-in (Firebase console -> Authentication -> Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloud camera registry (metadata only).
EXPO_PUBLIC_CLOUD_URL=http://127.0.0.1:8000

# The local agent's API token. The agent requires one on every camera endpoint,
# and a phone normally learns it by pairing — the box's /pair QR carries it, and
# it is then kept in SecureStore. This is the development path, for a build
# pointed at a box on a desk; a paired token takes precedence. Leave it blank in
# anything you ship, so the token is never baked into a bundle (EXPO_PUBLIC_* is
# inlined at build time and is readable by anyone with the app).
EXPO_PUBLIC_AGENT_TOKEN=

# Nothing here for the relay's password. The app is handed it by the box it
# paired with, over the agent's authenticated /api/pair — never from a build.
# EXPO_PUBLIC_* is inlined at build time and readable by anyone holding the APK,
# and one APK is installed at every site, so a baked-in relay password would be
# every site's relay password.

# go2rtc relay on the local network. iOS cannot play RTSP directly, so live
# view needs this. Leave blank to hide live view.
EXPO_PUBLIC_GO2RTC_URL=

# ── The ZeroForg dashboard's own API ──────────────────────────────────────
# Same Firebase project as the app, so the phone's token is accepted as-is.
# Org, sites, roles and permissions all come from here (GET /realm and
# GET /console/manifest). A public host, so it does not move with DHCP the
# way EXPO_PUBLIC_CLOUD_URL does.
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.zeroforg.com/api/v1

