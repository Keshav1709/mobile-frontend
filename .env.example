# Firebase web config. Leave blank to run in development mode:
# sign-in mints an unverified local token that the cloud registry accepts
# while CLOUD_ENV is not "production".
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client IDs for Google sign-in (Firebase console -> Authentication -> Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloud camera registry (metadata only).
EXPO_PUBLIC_CLOUD_URL=http://127.0.0.1:8000

# go2rtc relay on the local network. iOS cannot play RTSP directly, so live
# view needs this. Leave blank to hide live view.
EXPO_PUBLIC_GO2RTC_URL=

# ── The ZeroForg dashboard's own API ──────────────────────────────────────
# Same Firebase project as the app, so the phone's token is accepted as-is.
# Org, sites, roles and permissions all come from here (GET /realm and
# GET /console/manifest). A public host, so it does not move with DHCP the
# way EXPO_PUBLIC_CLOUD_URL does.
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.zeroforg.com/api/v1

